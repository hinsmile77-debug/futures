"""
validation.py — 3중 방어선 검증 프레임워크
 
과적합/점수 부풀림은 서로 다른 3개의 경로로 들어온다. 각각 다른 방어가 필요하다.
 
  누출 경로 1. 시간적 누출  : 검증셋 라벨의 미래가 학습셋에 들어감
              → 방어: Purging + Embargo         (Layer 1)
 
  누출 경로 2. 표본 중복    : 겹친 라벨을 독립 표본으로 착각
              → 방어: 고유성 가중치 + 순차 부트스트랩 (labeling.py + 본 모듈)
 
  누출 경로 3. 선택 편향    : 여러 번 돌려 제일 좋은 걸 고름
              → 방어: CPCV 경로 분포 + DSR + PBO   (Layer 2, 3)
 
3번이 가장 많이 방치되는 구멍이다. 백테스트를 100번 돌려 최고를 고르면
그 샤프는 실력이 아니라 최댓값 통계량이다.
 
참고: Lopez de Prado, "Advances in Financial Machine Learning" (2018)
      Bailey & Lopez de Prado, "The Deflated Sharpe Ratio" (2014)
      Bailey et al., "The Probability of Backtest Overfitting" (2015)
"""
 
from __future__ import annotations
 
import itertools
 
import numpy as np
import pandas as pd
from scipy.stats import norm
 
__all__ = [
    "purged_train_indices",
    "PurgedKFold",
    "purged_kfold_splits",
    "cpcv_splits",
    "cpcv_backtest_paths",
    "walk_forward_splits",
    "sequential_bootstrap",
    "sharpe_ratio",
    "max_drawdown",
    "expected_max_sharpe",
    "deflated_sharpe_ratio",
    "probability_of_backtest_overfitting",
    "leakage_selftest",
]
 
 
# ===========================================================================
# Layer 1. 시간적 누출 차단 — Purging + Embargo
# ===========================================================================
 
def _contiguous_blocks(sorted_idx: np.ndarray) -> list[tuple[int, int]]:
    """정렬된 위치 배열을 [start, end) 연속 블록 목록으로 자른다."""
    if len(sorted_idx) == 0:
        return []
    breaks = np.where(np.diff(sorted_idx) != 1)[0]
    starts = np.concatenate([[0], breaks + 1])
    ends = np.concatenate([breaks + 1, [len(sorted_idx)]])
    return [(int(sorted_idx[s]), int(sorted_idx[e - 1]) + 1)
            for s, e in zip(starts, ends)]
 
 
def purged_train_indices(t1: pd.Series, test_idx: np.ndarray,
                         embargo: int = 0) -> np.ndarray:
    """테스트 구간과 시간적으로 겹치는 학습 표본을 제거한다.
 
    t1 : index = 각 표본의 진입 시각 t0 (시간 오름차순 정렬 필수)
         value = 각 표본의 청산 시각 t1 (트리플 배리어의 '실제 터치 시각')
 
    Purging : 학습 표본의 [t0, t1] 이 테스트 블록의 [T0, T1] 과 조금이라도
              겹치면 제거한다. 겹치면 그 학습 표본은 테스트의 정답을 이미 본 것이다.
 
    Embargo : 테스트 블록 직후 일정 기간을 학습에서 통째로 배제한다.
              자기상관 때문에 t1 이 지난 직후 데이터도 정보를 흘린다.
    """
    n = len(t1)
    t0_vals = t1.index.to_numpy()
    t1_vals = t1.to_numpy()
 
    mask = np.ones(n, dtype=bool)
    mask[test_idx] = False
 
    for st, en in _contiguous_blocks(np.sort(np.asarray(test_idx))):
        blk_t0, blk_t1 = t0_vals[st], t1_vals[st:en].max()
        # Purge: 구간이 겹치는 모든 학습 표본 제거
        overlap = (t1_vals >= blk_t0) & (t0_vals <= blk_t1)
        mask &= ~overlap
        # Embargo: 테스트 블록 이후 embargo 개 표본 배제
        if embargo > 0:
            emb_start = int(np.searchsorted(t0_vals, blk_t1, side="right"))
            mask[emb_start:min(n, emb_start + embargo)] = False
 
    return np.where(mask)[0]
 
 
def purged_kfold_splits(t1: pd.Series, n_splits: int = 6,
                        embargo_pct: float = 0.01):
    """Purged K-Fold. 테스트 폴드는 '시간 연속' 블록이다 (셔플 금지)."""
    n = len(t1)
    embargo = int(n * embargo_pct)
    for block in np.array_split(np.arange(n), n_splits):
        yield purged_train_indices(t1, block, embargo), block
 
 
class PurgedKFold:
    """sklearn 호환 splitter. cross_val_score / GridSearchCV 에 그대로 꽂힌다."""
 
    def __init__(self, t1: pd.Series, n_splits: int = 6, embargo_pct: float = 0.01):
        self.t1 = t1
        self.n_splits = n_splits
        self.embargo_pct = embargo_pct
 
    def get_n_splits(self, X=None, y=None, groups=None) -> int:
        return self.n_splits
 
    def split(self, X=None, y=None, groups=None):
        yield from purged_kfold_splits(self.t1, self.n_splits, self.embargo_pct)
 
 
# ===========================================================================
# Layer 2. 선택 편향 차단 (1) — CPCV: 백테스트 '경로'의 분포를 얻는다
# ===========================================================================
 
def cpcv_splits(t1: pd.Series, n_groups: int = 6, n_test_groups: int = 2,
                embargo_pct: float = 0.01):
    """Combinatorial Purged CV.
 
    N개 그룹 중 k개를 테스트로 뽑는 모든 조합 C(N,k)를 검증한다.
    단일 백테스트가 '한 번의 운'이라면, CPCV는 여러 개의 대체 역사를 만들어
    성과의 **분포**를 준다. 샤프 하나가 아니라 샤프의 신뢰구간을 얻는 것이 목적.
 
    N=6, k=2 → 15개 폴드 / 5개의 독립 백테스트 경로
    """
    n = len(t1)
    embargo = int(n * embargo_pct)
    groups = np.array_split(np.arange(n), n_groups)
    for combo in itertools.combinations(range(n_groups), n_test_groups):
        test_idx = np.sort(np.concatenate([groups[g] for g in combo]))
        yield purged_train_indices(t1, test_idx, embargo), test_idx, combo
 
 
def n_cpcv_paths(n_groups: int, n_test_groups: int) -> int:
    """CPCV가 만들어내는 독립 백테스트 경로의 개수."""
    from math import comb
    return comb(n_groups, n_test_groups) * n_test_groups // n_groups
 
 
def cpcv_backtest_paths(preds_by_combo: dict, n_groups: int,
                        n_test_groups: int) -> list[pd.Series]:
    """폴드별 예측을 경로(path)로 재조립한다.
 
    preds_by_combo : {combo(tuple): pd.Series(예측 또는 수익률, index=시각)}
    반환 : 경로 개수만큼의 pd.Series. 각각이 하나의 완전한 백테스트다.
    """
    slots = {g: [] for g in range(n_groups)}
    for combo, s in preds_by_combo.items():
        parts = np.array_split(np.arange(len(s)), n_test_groups)
        for g, part in zip(combo, parts):
            slots[g].append(s.iloc[part])
 
    n_paths = min(len(v) for v in slots.values())
    return [pd.concat([slots[g][p] for g in range(n_groups)]).sort_index()
            for p in range(n_paths)]
 
 
# ===========================================================================
# Layer 1b. 순차 부트스트랩 — 중복 표본을 덜 뽑는 배깅
# ===========================================================================
 
def sequential_bootstrap(ind_matrix: np.ndarray, size: int | None = None,
                         rng: np.random.Generator | None = None) -> np.ndarray:
    """이미 뽑힌 표본과 겹치지 않는 표본을 우선적으로 뽑는 부트스트랩.
 
    ind_matrix : (n_bars, n_samples) 0/1 지시행렬. 표본 j가 바 t를 점유하면 1.
    표준 부트스트랩은 겹친 표본을 그대로 중복 추출해 독립성 착각을 키운다.
    """
    rng = rng or np.random.default_rng(0)
    n = ind_matrix.shape[1]
    size = size or n
    picked, occupancy = [], np.zeros(ind_matrix.shape[0])
    for _ in range(size):
        avg_u = np.empty(n)
        for j in range(n):
            col = ind_matrix[:, j]
            active = col > 0
            c = occupancy[active] + 1.0
            avg_u[j] = (1.0 / c).mean()
        prob = avg_u / avg_u.sum()
        j = rng.choice(n, p=prob)
        picked.append(j)
        occupancy += ind_matrix[:, j]
    return np.array(picked)
 
 
def build_indicator_matrix(bar_index: pd.Index, labels: pd.DataFrame) -> np.ndarray:
    """sequential_bootstrap 용 지시행렬 생성."""
    starts = bar_index.searchsorted(labels.index)
    ends = np.minimum(bar_index.searchsorted(labels["t1"].to_numpy()),
                      len(bar_index) - 1)
    m = np.zeros((len(bar_index), len(labels)))
    for j, (s, e) in enumerate(zip(starts, ends)):
        m[s:e + 1, j] = 1.0
    return m
 
 
# ===========================================================================
# Layer 3. 선택 편향 차단 (2) — 성과 통계
# ===========================================================================
 
def sharpe_ratio(returns: pd.Series, periods_per_year: int = 252) -> float:
    r = pd.Series(returns).dropna()
    if len(r) < 2 or r.std(ddof=1) == 0:
        return 0.0
    return float(r.mean() / r.std(ddof=1) * np.sqrt(periods_per_year))
 
 
def max_drawdown(returns: pd.Series) -> float:
    eq = (1 + pd.Series(returns).fillna(0)).cumprod()
    return float((eq / eq.cummax() - 1).min())
 
 
def walk_forward_splits(n: int, n_folds: int = 5, min_train: float = 0.3,
                        anchored: bool = True):
    """Walk-Forward (확장/롤링 윈도우). 시간 순서를 그대로 지키는 현실 시뮬레이션.
 
    CPCV가 '통계적 검증'이라면 Walk-Forward는 '운영 리허설'이다. 둘 다 필요하다.
    """
    start = int(n * min_train)
    bounds = np.linspace(start, n, n_folds + 1).astype(int)
    for a, b in zip(bounds[:-1], bounds[1:]):
        train = np.arange(0, a) if anchored else np.arange(max(0, a - start), a)
        yield train, np.arange(a, b)
 
 
def expected_max_sharpe(n_trials: int, var_sharpe: float) -> float:
    """N번 시도했을 때 '실력이 0이어도' 우연히 나오는 최대 샤프의 기댓값.
 
    파라미터 100개 조합을 돌려 최고를 골랐다면, 그 샤프는 최소 이만큼은
    거저 나온다. 이 값을 넘지 못하면 발견이 아니라 잡음이다.
    """
    if n_trials < 2:
        return 0.0
    gamma = 0.5772156649015329  # Euler-Mascheroni
    a = (1 - gamma) * norm.ppf(1 - 1.0 / n_trials)
    b = gamma * norm.ppf(1 - 1.0 / (n_trials * np.e))
    return float(np.sqrt(var_sharpe) * (a + b))
 
 
def deflated_sharpe_ratio(returns: pd.Series, n_trials: int,
                          var_sharpe: float | None = None,
                          periods_per_year: int = 252,
                          sharpe_trials: np.ndarray | None = None) -> dict:
    """Deflated Sharpe Ratio — 점수 부풀림에 대한 최종 방어선.
 
    관측 샤프가 '시도 횟수를 감안해도' 0보다 크다고 말할 수 있는 확률.
    수익률의 왜도(음의 왜도 = 나쁨)와 첨도(팻테일 = 나쁨)까지 벌점으로 반영한다.
 
    DSR >= 0.95 를 통과 기준으로 삼는다. 미만이면 전략을 폐기한다.
 
    n_trials      : 실제로 시도한 파라미터/모델 조합 수 (정직하게 셀 것!)
    sharpe_trials : 시도들의 샤프 배열. 주면 var_sharpe를 여기서 추정한다.
    """
    r = pd.Series(returns).dropna()
    T = len(r)
    if T < 3:
        return {"sharpe": 0.0, "sr_threshold": np.nan, "dsr": 0.0, "n_obs": T}
 
    sr_ann = sharpe_ratio(r, periods_per_year)
    sr = sr_ann / np.sqrt(periods_per_year)          # 주기당 샤프
    skew = float(r.skew())
    kurt = float(r.kurtosis()) + 3.0                 # 비초과 첨도
 
    if var_sharpe is None:
        var_sharpe = (float(np.var(np.asarray(sharpe_trials) /
                                   np.sqrt(periods_per_year), ddof=1))
                      if sharpe_trials is not None and len(sharpe_trials) > 1
                      else (1 + 0.5 * sr ** 2) / T)
 
    sr0 = expected_max_sharpe(n_trials, var_sharpe)
    denom = np.sqrt(max(1e-12, 1 - skew * sr + (kurt - 1) / 4.0 * sr ** 2))
    z = (sr - sr0) * np.sqrt(T - 1) / denom
    return {
        "sharpe": sr_ann,
        "sr_threshold": float(sr0 * np.sqrt(periods_per_year)),
        "dsr": float(norm.cdf(z)),
        "n_obs": T,
        "skew": skew,
        "kurtosis": kurt,
        "pass": bool(norm.cdf(z) >= 0.95),
    }
 
 
def probability_of_backtest_overfitting(returns_matrix: pd.DataFrame,
                                        n_splits: int = 12) -> dict:
    """PBO (CSCV 방식) — "인샘플 1등이 아웃샘플에서 평범 이하일 확률".
 
    returns_matrix : (T x N). 열 = 시도한 전략/파라미터 조합, 행 = 시점 수익률.
 
    데이터를 S개 블록으로 나눠, 절반을 IS·나머지를 OS로 하는 모든 조합에서
      1) IS 최고 전략을 고르고
      2) 그 전략이 OS에서 몇 등인지 본다.
    중앙값 이하로 떨어지는 비율이 PBO.
 
    PBO < 0.2  : 견고
    PBO > 0.5  : 전략 선택 과정 자체가 과적합. 결과 전체를 폐기한다.
    """
    R = returns_matrix.dropna(how="any")
    T, N = R.shape
    if N < 2 or n_splits < 2:
        raise ValueError("전략 2개 이상, 블록 2개 이상이 필요합니다.")
    if n_splits % 2 == 1:
        n_splits += 1
 
    blocks = np.array_split(np.arange(T), n_splits)
    half = n_splits // 2
    logits, oos_ranks = [], []
 
    for combo in itertools.combinations(range(n_splits), half):
        is_idx = np.concatenate([blocks[b] for b in combo])
        os_idx = np.concatenate([blocks[b] for b in range(n_splits)
                                 if b not in combo])
        is_sr = R.iloc[is_idx].mean() / R.iloc[is_idx].std(ddof=1).replace(0, np.nan)
        os_sr = R.iloc[os_idx].mean() / R.iloc[os_idx].std(ddof=1).replace(0, np.nan)
        if is_sr.isna().all() or os_sr.isna().all():
            continue
        best = is_sr.idxmax()
        rank = os_sr.rank(pct=False).loc[best]           # 1 = 최악
        w = rank / (N + 1)
        w = min(max(w, 1e-6), 1 - 1e-6)
        logits.append(np.log(w / (1 - w)))
        oos_ranks.append(w)
 
    logits = np.array(logits)
    return {
        "pbo": float((logits <= 0).mean()),
        "median_oos_percentile": float(np.median(oos_ranks)),
        "n_combinations": len(logits),
        "pass": bool((logits <= 0).mean() < 0.2),
    }
 
 
# ===========================================================================
# 자가 진단 — 누출 방지가 실제로 작동하는지 확인
# ===========================================================================
 
def leakage_selftest(t1: pd.Series, n_splits: int = 6,
                     embargo_pct: float = 0.01) -> pd.DataFrame:
    """각 폴드에서 학습/테스트 구간이 실제로 겹치지 않는지 직접 확인한다.
 
    overlap_count 가 0이 아니면 퍼징이 깨진 것이다. 파이프라인을 바꿀 때마다
    이 테스트를 돌려라. 조용히 새는 누출이 가장 비싸다.
    """
    t0_vals = t1.index.to_numpy()
    t1_vals = t1.to_numpy()
    rows = []
    for k, (tr, te) in enumerate(purged_kfold_splits(t1, n_splits, embargo_pct)):
        T0, T1 = t0_vals[te].min(), t1_vals[te].max()
        overlap = ((t1_vals[tr] >= T0) & (t0_vals[tr] <= T1)).sum()
        rows.append({
            "fold": k,
            "n_train": len(tr),
            "n_test": len(te),
            "train_kept_pct": round(100 * len(tr) / (len(t1) - len(te)), 1),
            "overlap_count": int(overlap),
            "ok": overlap == 0,
        })
    return pd.DataFrame(rows)
 

