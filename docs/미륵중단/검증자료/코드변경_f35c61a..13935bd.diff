+
+    LIGHT_PASS_PARTS = TS.LIGHT_PASS_PARTS
+    _light_minute_pass = TS._light_minute_pass
+    _light_minute_pass_dry = TS._light_minute_pass_dry
+    _bar_price_guard = TS._bar_price_guard
